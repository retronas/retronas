# curlftpfs

set -ue

VERS=${1:-0.9.2}
APPNAME=curlftpfs-${VERS}
APPFILE=${APPNAME}.tar.gz
REPO=https://ixpeering.dl.sourceforge.net/project/curlftpfs/curlftpfs/${VERS}/${APPFILE}?viasf=1
BUILDPATH={{ retronas_root }}/src


[ ! -d ${BUILDPATH} ] && mkdir -p ${BUILDPATH}

cd ${BUILDPATH}
if $(curl -Lo ${APPFILE} { $REPO) 
then
    tar xvf ${APPFILE}
    cd ${APPNAME}
    ./configure
    make
    make install
fi

rm -rf ${BUILDPATH}
